    "source": "import os,time,signal\nsignal.alarm(4)\npid=os.fork()\nif pid==0:\n    with open('/proc/self/oom_score_adj','w') as f:f.write('1000')\n    blocks=[]\n    for _ in range(160):\n        blocks.append(bytearray(1048576))\n        time.sleep(0.003)\n    os._exit(0)\n_,status=os.waitpid(pid,0)\nprint(os.waitstatus_to_exitcode(status))\ntime.sleep(0.5)\n",
